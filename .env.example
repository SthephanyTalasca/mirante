# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # só no servidor e no worker — nunca no navegador

# IA multimodal (escolha do provedor é por organização, em Configurações)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# OPENAI_BASE_URL=                  # opcional: Azure OpenAI ou gateway compatível

# Custos (USD por milhão de tokens) — usados para estimar o custo de cada análise
AI_PRICE_INPUT_PER_MTOK=3
AI_PRICE_OUTPUT_PER_MTOK=15

# Worker
AI_CONCURRENCY=4
WORKER_POLL_MS=4000
GATE_NO_IMAGE_STD=6                 # abaixo disso o recorte é considerado sem imagem
GATE_STATIC_DIFF=2.5                # abaixo disso a janela é considerada estática
GATE_MAX_CHAIN=3                    # máx. de janelas propagadas seguidas antes de reanalisar

# Rotina de retenção (Vercel Cron envia Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
